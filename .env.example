ATLASDB_URL=mongodb://127.0.0.1:27017/travelbychance
SECRET=your_session_secret
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
MAP_TOKEN=your_mapbox_public_token
# Optional: override DNS resolvers if your network can't resolve Atlas SRV records.
# DNS_SERVERS=8.8.8.8,8.8.4.4
# Optional: number of reverse proxies in front of the app (production behind nginx/Render = 1)
# TRUST_PROXY=1
# Optional: site served over HTTPS -> Secure cookies. Defaults to NODE_ENV=production.
# Must be false when using plain http:// (e.g. Docker on localhost), or login silently fails.
# HTTPS_ONLY=
# Only used by `npm run create-admin`
# ADMIN_PASSWORD=
# Razorpay TEST mode (Dashboard -> switch to Test Mode -> Account & Settings -> API Keys).
# Never commit real values. Live keys (rzp_live_) are refused unless ALLOW_LIVE_PAYMENTS=true.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=        # optional locally; reconciliation works without webhooks
# Booking lifecycle (defaults shown). REQUIRE_PAYMENT defaults to true when Razorpay keys are set.
# REQUIRE_PAYMENT=
# BOOKING_HOLD_MINUTES=15
# RUN_BACKGROUND_JOBS=true
# JOB_INTERVAL_SECONDS=30
# BOOKING_TIMEZONE=Asia/Kolkata
