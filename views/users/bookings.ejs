<% layout('/layouts/boilerplate') %>

<!-- Header -->
<div style="margin: 2rem 0 2.5rem;">
  <h1 style="font-size: 1.85rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.3rem;">My Reservations</h1>
  <p style="color: var(--text-muted); font-size: 0.95rem;">Manage your upcoming stays and travel history</p>
</div>

<% if (bookings.length === 0) { %>
  <!-- Empty State -->
  <div style="text-align: center; padding: 5rem 2rem; background: white; border-radius: var(--radius-lg); border: 1px dashed var(--border-main);">
    <div style="width: 72px; height: 72px; background: var(--bg-subtle); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
      <i class="fa-solid fa-calendar-xmark" style="font-size: 1.8rem; color: var(--border-dark);"></i>
    </div>
    <h3 style="font-weight: 800; margin-bottom: 0.5rem; font-size: 1.3rem;">No reservations yet</h3>
    <p style="color: var(--text-muted); max-width: 400px; margin: 0 auto 1.75rem; font-size: 0.95rem;">
      You haven't made any bookings yet. Start exploring our premium curated stays to plan your next getaway!
    </p>
    <a href="/listings" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 2rem; background: var(--primary); color: white; border-radius: var(--radius-pill); font-weight: 700; font-size: 0.95rem; text-decoration: none; box-shadow: 0 4px 14px rgba(255,56,92,0.3); transition: all 0.22s;"
      onmouseover="this.style.transform='translateY(-2px)';"
      onmouseout="this.style.transform='';">
      <i class="fa-solid fa-compass"></i> Explore Stays
    </a>
  </div>

<% } else { %>
  <div class="row g-4">
    <% for (let booking of bookings) { %>
      <% if (booking.listing) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div style="background: white; border: 1px solid var(--border-main); border-radius: var(--radius-lg); overflow: hidden; height: 100%; transition: all 0.22s; display: flex; flex-direction: column;"
            onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-lg)';"
            onmouseout="this.style.transform=''; this.style.boxShadow='';">

            <!-- Image -->
            <div style="height: 200px; overflow: hidden; position: relative;">
              <img src="<%= booking.listing.image?.url || booking.listing.image %>"
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                alt="<%= booking.listing.title %>"
                onmouseover="this.style.transform='scale(1.04)';"
                onmouseout="this.style.transform='';">
              <% const st = booking.status || "CONFIRMED"; const stLabel = st.replace("_", " ").toLowerCase();
                 const stColor = { CONFIRMED: "var(--success)", PENDING_PAYMENT: "var(--amber-dark, #b7791f)", REFUND_PENDING: "var(--amber-dark, #b7791f)" }[st] || "var(--text-muted)";
                 // booking.status (not st): pre-upgrade bookings have no status and can't
                 // be cancelled until `npm run migrate:bookings` has run.
                 const canCancel = ["CONFIRMED", "PENDING_PAYMENT"].includes(booking.status) && booking.checkIn > today; %>
              <span style="position: absolute; top: 12px; right: 12px; background: <%= stColor %>; color: white; font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.85rem; border-radius: var(--radius-pill); text-transform: capitalize;">
                <i class="fa-solid <%= st === "CONFIRMED" ? "fa-check" : "fa-circle-info" %> me-1"></i><%= stLabel %>
              </span>
            </div>

            <!-- Body -->
            <div style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1;">
              <div style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.4rem;">
                <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                <%= booking.listing.location %>, <%= booking.listing.country %>
              </div>
              <h5 style="font-weight: 800; font-size: 1rem; margin-bottom: 1rem; color: var(--dark); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                <%= booking.listing.title %>
              </h5>

              <!-- Dates -->
              <div style="background: var(--bg-subtle); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem; font-size: 0.88rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                  <span style="color: var(--text-muted); font-weight: 600;"><i class="fa-solid fa-plane-arrival me-1"></i> Check-in</span>
                  <span style="font-weight: 700; color: var(--dark);">
                    <%= booking.checkIn.toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
                  </span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                  <span style="color: var(--text-muted); font-weight: 600;"><i class="fa-solid fa-plane-departure me-1"></i> Check-out</span>
                  <span style="font-weight: 700; color: var(--dark);">
                    <%= booking.checkOut.toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
                  </span>
                </div>
              </div>

              <% if (st === "PENDING_PAYMENT" && booking.expiresAt) { %>
                <p style="font-size: 0.82rem; color: var(--text-muted); margin: -0.25rem 0 1rem;">
                  <i class="fa-regular fa-clock me-1"></i>Held until <%= booking.expiresAt.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" }) %> IST, then released if unpaid
                </p>
              <% } %>
              <% if (st === "PENDING_PAYMENT" && paymentsEnabled && booking.expiresAt > new Date()) { %>
                <button type="button" onclick="payForBooking('<%= booking._id %>', (m) => { this.textContent = m; })" style="width: 100%; padding: 0.55rem; margin-bottom: 0.6rem; border: none; border-radius: var(--radius-pill); background: var(--primary); color: white; font-size: 0.85rem; font-weight: 700; cursor: pointer;">
                  <i class="fa-solid fa-lock me-1"></i>Pay <%= formatPaise(booking.amountPaise) %> now<% if (paymentsMode === "demo") { %> (demo)<% } %>
                </button>
              <% } %>
              <% if (st === "REFUND_PENDING") { %>
                <p style="font-size: 0.82rem; color: var(--text-muted); margin: -0.25rem 0 1rem;"><i class="fa-solid fa-rotate-left me-1"></i>Refund requested. It will show as refunded once the payment provider confirms it.</p>
              <% } %>
              <% if (canCancel) { %>
                <form method="POST" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Cancel this booking? The dates will be released.');" style="margin-bottom: 1rem;">
                  <button type="submit" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-main); border-radius: var(--radius-pill); background: white; font-size: 0.82rem; font-weight: 700; color: var(--danger); cursor: pointer;">
                    <i class="fa-solid fa-xmark me-1"></i>Cancel booking
                  </button>
                </form>
              <% } %>

              <!-- Price + Link -->
              <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--border-light);">
                <div>
                  <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">Total</div>
                  <div style="font-size: 1.25rem; font-weight: 800; color: var(--primary);">₹<%= booking.totalPrice.toLocaleString("en-IN") %></div>
                </div>
                <a href="/listings/<%= booking.listing._id %>"
                  style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.1rem; border: 1.5px solid var(--border-dark); border-radius: var(--radius-pill); font-size: 0.82rem; font-weight: 700; color: var(--dark); text-decoration: none; transition: all 0.22s;"
                  onmouseover="this.style.background='var(--dark)'; this.style.color='white'; this.style.borderColor='var(--dark)';"
                  onmouseout="this.style.background=''; this.style.color='var(--dark)'; this.style.borderColor='var(--border-dark)';">
                  View Stay <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
<% } %>

<div style="margin-bottom: 3rem;"></div>

<% if (paymentsEnabled) { %>
<% if (paymentsMode === "razorpay") { %><script src="https://checkout.razorpay.com/v1/checkout.js"></script><% } %>
<script src="/js/payments.js"></script>
<% } %>
