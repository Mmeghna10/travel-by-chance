<% layout('/layouts/landing_boilerplate') %>

<!-- ========== HERO SECTION ========== -->
<div class="hero-landing">
  <div class="hero-grid-texture"></div>
  <div class="container text-center position-relative" style="z-index: 2;">

    <div class="hero-pill-tag">
      <i class="fa-solid fa-compass"></i>
      Discover the Extraordinary
    </div>

    <h1 class="hero-title-bold">
      Discover <span class="hero-title-gradient">Exceptional Stays</span><br>Across India
    </h1>
    <p class="hero-subtext mx-auto">
      Handpicked cabins, mountain retreats, tropical villas, and heritage havens — curated for unforgettable journeys.
    </p>

    <!-- Search Widget -->
    <div class="hero-search-card">
      <form action="/listings" method="GET" class="hero-search-form">
        <div class="row g-0 align-items-center">
          <div class="col-12 col-md-5 text-start" style="padding: 0.5rem 1.1rem; border-right: 1px solid var(--border-main);">
            <label class="form-label-hero"><i class="fa-solid fa-location-dot me-1" style="color: var(--primary);"></i>Where to?</label>
            <input type="text" name="q" class="form-input-hero w-100" placeholder="Cities or states, e.g. Goa, Jaipur..." />
          </div>
          <div class="col-12 col-md-4 text-start position-relative" style="padding: 0.5rem 1.1rem; border-right: 1px solid var(--border-main);">
            <label class="form-label-hero"><i class="fa-solid fa-tags me-1" style="color: var(--amber);"></i>Stay Type</label>
            <div class="dropdown">
              <input type="hidden" name="category" id="hero-category-input" value="">
              <button class="custom-select-trigger dropdown-toggle" type="button" id="heroCategoryDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <span id="hero-category-label">All Categories</span>
                <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--primary);"></i>
              </button>
              <ul class="dropdown-menu custom-select-dropdown w-100 mt-2" aria-labelledby="heroCategoryDropdown">
                <li><a class="dropdown-item active" href="#" onclick="selectHeroCategory('', 'All Categories', this, event)"><i class="fa-solid fa-layer-group me-2" style="color:var(--primary);"></i>All Categories</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Trending', 'Trending', this, event)"><i class="fa-solid fa-fire me-2" style="color:#B26335;"></i>Trending</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Rooms', 'Rooms', this, event)"><i class="fa-solid fa-bed me-2" style="color:#7A3A14;"></i>Rooms</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Iconic Cities', 'Iconic Cities', this, event)"><i class="fa-solid fa-mountain-city me-2" style="color:#3B3A1E;"></i>Iconic Cities</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Mountains', 'Mountains', this, event)"><i class="fa-solid fa-mountain me-2" style="color:#4F4E28;"></i>Mountains</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Castles', 'Castles', this, event)"><i class="fa-solid fa-chess-rook me-2" style="color:#5D2C0C;"></i>Castles</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Amazing Pools', 'Pools', this, event)"><i class="fa-solid fa-person-swimming me-2" style="color:#2E6E65;"></i>Amazing Pools</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Camping', 'Camping', this, event)"><i class="fa-solid fa-campground me-2" style="color:#3B5C2A;"></i>Camping</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Farms', 'Farms', this, event)"><i class="fa-solid fa-seedling me-2" style="color:#6B5220;"></i>Farms</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Arctic', 'Arctic', this, event)"><i class="fa-solid fa-snowflake me-2" style="color:#3A5E7A;"></i>Arctic</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Domes', 'Domes', this, event)"><i class="fa-solid fa-igloo me-2" style="color:#5E3E2C;"></i>Domes</a></li>
                <li><a class="dropdown-item" href="#" onclick="selectHeroCategory('Boats', 'Boats', this, event)"><i class="fa-solid fa-sailboat me-2" style="color:#2A4E78;"></i>Boats</a></li>
              </ul>
            </div>
          </div>
          <div class="col-12 col-md-3" style="padding: 0.5rem 0.75rem;">
            <button type="submit" class="btn-search-hero-submit">
              <i class="fa-solid fa-magnifying-glass"></i> Search Stays
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- CTA Buttons -->
    <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
      <a href="/listings" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;background:var(--cream);color:var(--dark);border-radius:var(--radius-pill);font-weight:700;font-size:0.95rem;text-decoration:none;transition:all 0.24s;box-shadow:0 2px 8px rgba(58,31,8,0.12);"
        onmouseover="this.style.background='white';" onmouseout="this.style.background='var(--cream)';">
        <i class="fa-solid fa-earth-americas"></i> Browse All Stays
      </a>
      <% if (typeof currUser === 'undefined' || !currUser) { %>
        <a href="/signup" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;background:rgba(221,163,92,0.18);color:var(--amber);border:1px solid rgba(221,163,92,0.4);border-radius:var(--radius-pill);font-weight:700;font-size:0.95rem;text-decoration:none;transition:all 0.24s;backdrop-filter:blur(8px);"
          onmouseover="this.style.background='rgba(221,163,92,0.28)';" onmouseout="this.style.background='rgba(221,163,92,0.18)';">
          <i class="fa-solid fa-house-laptop"></i> Become a Host
        </a>
      <% } else if (currUser.role === 'admin') { %>
        <a href="/listings/new" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;background:rgba(221,163,92,0.18);color:var(--amber);border:1px solid rgba(221,163,92,0.4);border-radius:var(--radius-pill);font-weight:700;font-size:0.95rem;text-decoration:none;transition:all 0.24s;"
          onmouseover="this.style.background='rgba(221,163,92,0.28)';" onmouseout="this.style.background='rgba(221,163,92,0.18)';">
          <i class="fa-solid fa-plus"></i> Add a Stay
        </a>
      <% } %>
    </div>

    <!-- Stats: real numbers from the database (they used to be made up) -->
    <% if (stats && stats.stays > 0) { %>
    <div class="d-flex justify-content-center gap-5 mt-5 flex-wrap">
      <div class="text-center">
        <div style="font-family:var(--font-display);font-size:2.2rem;font-weight:600;color:var(--cream);letter-spacing:-0.02em;"><%= stats.stays %></div>
        <div style="font-size:0.75rem;color:rgba(227,222,202,0.5);text-transform:uppercase;letter-spacing:0.08em;font-weight:700;"><%= stats.stays === 1 ? 'Stay' : 'Stays' %></div>
      </div>
      <div style="width:1px;background:rgba(227,222,202,0.15);align-self:stretch;"></div>
      <div class="text-center">
        <div style="font-family:var(--font-display);font-size:2.2rem;font-weight:600;color:var(--cream);letter-spacing:-0.02em;"><%= stats.cities %></div>
        <div style="font-size:0.75rem;color:rgba(227,222,202,0.5);text-transform:uppercase;letter-spacing:0.08em;font-weight:700;"><%= stats.cities === 1 ? 'City' : 'Cities' %> in India</div>
      </div>
      <% if (stats.reviews > 0) { %>
      <div style="width:1px;background:rgba(227,222,202,0.15);align-self:stretch;"></div>
      <div class="text-center">
        <div style="font-family:var(--font-display);font-size:2.2rem;font-weight:600;color:var(--amber);letter-spacing:-0.02em;"><%= stats.avgRating + ' ★' %></div>
        <div style="font-size:0.75rem;color:rgba(227,222,202,0.5);text-transform:uppercase;letter-spacing:0.08em;font-weight:700;">Avg rating · <%= stats.reviews %> <%= stats.reviews === 1 ? 'review' : 'reviews' %></div>
      </div>
      <% } %>
    </div>
    <% } %>

  </div>
</div>

<!-- ========== BROWSE BY CATEGORY ========== -->
<section style="padding:5rem 0;background:var(--bg-main);">
  <div class="container">
    <div class="text-center mb-5">
      <span style="display:inline-block;background:var(--primary-light);color:var(--primary);padding:0.35rem 1rem;border-radius:var(--radius-pill);font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.9rem;">Browse by Vibe</span>
      <h2 style="font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:600;letter-spacing:-0.01em;margin-bottom:0.6rem;color:var(--dark);">What kind of trip are you planning?</h2>
      <p style="color:var(--text-muted);font-size:1rem;max-width:460px;margin:0 auto;">Filter our handpicked collection by your favourite travel styles</p>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 justify-content-center">
      <%
        const gbCategories = [
          { slug: 'Trending',      label: 'Trending',  icon: 'fa-fire',            color: '#B26335', bg: '#FBF0E8' },
          { slug: 'Rooms',         label: 'Rooms',     icon: 'fa-bed',             color: '#7A3A14', bg: '#F7EFE6' },
          { slug: 'Iconic Cities', label: 'Cities',    icon: 'fa-mountain-city',   color: '#3B3A1E', bg: '#F2F0E8' },
          { slug: 'Mountains',     label: 'Mountains', icon: 'fa-mountain',        color: '#4F4E28', bg: '#F0EFE2' },
          { slug: 'Castles',       label: 'Castles',   icon: 'fa-chess-rook',      color: '#5D2C0C', bg: '#F5EBE2' },
          { slug: 'Amazing Pools', label: 'Pools',     icon: 'fa-person-swimming', color: '#2E6E65', bg: '#EBF5F3' },
          { slug: 'Camping',       label: 'Camping',   icon: 'fa-campground',      color: '#3B5C2A', bg: '#EFF4EB' },
          { slug: 'Farms',         label: 'Farms',     icon: 'fa-seedling',        color: '#6B5220', bg: '#F5EFE2' },
          { slug: 'Arctic',        label: 'Arctic',    icon: 'fa-snowflake',       color: '#3A5E7A', bg: '#EBF2F7' },
          { slug: 'Domes',         label: 'Domes',     icon: 'fa-igloo',           color: '#5E3E2C', bg: '#F5EDE6' },
          { slug: 'Boats',         label: 'Boats',     icon: 'fa-sailboat',        color: '#2A4E78', bg: '#E8EFF8' },
        ];
      %>
      <% for (let cat of gbCategories) { %>
        <div class="col">
          <a href="/listings?category=<%= cat.slug %>" style="text-decoration:none;display:block;">
            <div style="background:white;border:1.5px solid var(--border-main);border-radius:var(--radius-md);padding:1.5rem 0.75rem 1.25rem;text-align:center;transition:all 0.24s;cursor:pointer;"
              onmouseover="this.style.borderColor='<%= cat.color %>30';this.style.transform='translateY(-4px)';this.style.boxShadow='var(--shadow-md)';"
              onmouseout="this.style.borderColor='var(--border-main)';this.style.transform='';this.style.boxShadow='';">
              <div style="width:52px;height:52px;background:<%= cat.bg %>;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 0.85rem;border:1px solid <%= cat.color %>22;">
                <i class="fa-solid <%= cat.icon %>" style="font-size:1.2rem;color:<%= cat.color %>;"></i>
              </div>
              <div style="font-size:0.85rem;font-weight:700;color:var(--text-main);"><%= cat.label %></div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ========== FEATURED STAYS ========== -->
<% if (typeof featuredListings !== 'undefined' && featuredListings && featuredListings.length > 0) { %>
<section style="padding:5rem 0;background:var(--cream-light);border-top:1px solid var(--border-main);border-bottom:1px solid var(--border-main);">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-5 flex-wrap gap-3">
      <div>
        <span style="display:inline-block;background:var(--amber-light);color:var(--amber-dark);padding:0.35rem 1rem;border-radius:var(--radius-pill);font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;border:1px solid var(--amber-border);margin-bottom:0.9rem;">Top Rated</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:600;margin-bottom:0.4rem;color:var(--dark);">Featured Destinations</h2>
        <p style="color:var(--text-muted);font-size:0.95rem;">Highly recommended properties that travellers fall in love with</p>
      </div>
      <a href="/listings" class="btn-outline-dark-cta">
        All Stays <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% for(let listing of featuredListings) { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" style="text-decoration:none;display:block;height:100%;">
            <div class="listing-card-pro h-100">
              <div class="card-img-container">
                <img src="<%= listing.image.url %>" class="card-img-src" alt="<%= listing.title %>" loading="lazy">
                <div class="wishlist-heart-btn" onclick="event.preventDefault();">
                  <i class="fa-regular fa-heart"></i>
                </div>
                <span class="card-category-badge">
                  <i class="fa-solid fa-tag me-1" style="font-size:0.65rem;"></i><%= listing.category %>
                </span>
              </div>
              <div class="card-body-content">
                <div class="card-location-row">
                  <i class="fa-solid fa-location-dot"></i>
                  <%= listing.location %>, <%= listing.country %>
                </div>
                <div class="card-title-heading"><%= listing.title %></div>
                <div class="card-rating-bar">
                  <% if (listing.averageRating && listing.averageRating > 0) { %>
                    <i class="fa-solid fa-star star-icon-fill"></i>
                    <span class="rating-num-text"><%= listing.averageRating %></span>
                    <span class="review-count-text">(<%= listing.reviews.length %> reviews)</span>
                  <% } else { %>
                    <span style="font-size:0.8rem;color:var(--text-subtle);">New — no reviews yet</span>
                  <% } %>
                </div>
                <div class="card-footer-price">
                  <div>
                    <span class="price-main-amount"><span class="price-symbol">₹</span><%= listing.price.toLocaleString("en-IN") %></span>
                    <span class="price-unit-label"> / night</span>
                  </div>
                  <span style="font-size:0.82rem;font-weight:700;color:var(--primary);">View Stay →</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<!-- ========== WHY TRAVELBYCHANCE ========== -->
<section style="padding:5.5rem 0;background:var(--bg-main);">
  <div class="container">
    <div class="text-center mb-5">
      <span style="display:inline-block;background:var(--primary-light);color:var(--primary);padding:0.35rem 1rem;border-radius:var(--radius-pill);font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.9rem;">Why Choose Us</span>
      <h2 style="font-family:var(--font-display);font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:600;margin-bottom:0.6rem;color:var(--dark);">The TravelByChance Difference</h2>
      <p style="color:var(--text-muted);font-size:1rem;max-width:460px;margin:0 auto;">We combine convenience, trust, and quality to make every stay exceptional.</p>
    </div>

    <div class="row g-4">
      <%
        const features = [
          { icon: 'fa-calendar-check',      color: '#B26335', bg: '#FBF0E8', title: 'Live Availability',    desc: 'See which nights are free before you book. Your dates are held while you pay, so nobody else can take them.' },
          { icon: 'fa-shield-halved',       color: '#5D2C0C', bg: '#F7EFE6', title: 'Secure Payments',      desc: 'Pay through Razorpay. Card and UPI details are entered on Razorpay and never reach our servers.' },
          { icon: 'fa-rotate-left',         color: '#DDA35C', bg: '#FDF5E6', title: 'Fair Cancellation',    desc: 'Cancel any time before your check-in date for a full refund, fees included.' },
          { icon: 'fa-route',               color: '#3B3A1E', bg: '#F2F0E8', title: 'Plan Your Arrival Day', desc: 'Tell us when you arrive and how you travel; we suggest what to see before and after check-in.' },
        ];
      %>
      <% for (let feat of features) { %>
        <div class="col-sm-6 col-lg-3">
          <div style="background:white;border:1px solid var(--border-main);border-radius:var(--radius-lg);padding:2rem 1.5rem;height:100%;transition:all 0.24s;cursor:default;"
            onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='var(--shadow-lg)';this.style.borderColor='var(--primary-border)';"
            onmouseout="this.style.transform='';this.style.boxShadow='';this.style.borderColor='var(--border-main)';">
            <div style="width:56px;height:56px;background:<%= feat.bg %>;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;margin-bottom:1.25rem;border:1px solid <%= feat.color %>22;">
              <i class="fa-solid <%= feat.icon %>" style="font-size:1.4rem;color:<%= feat.color %>;"></i>
            </div>
            <h4 style="font-size:1.02rem;font-weight:800;margin-bottom:0.6rem;color:var(--dark);"><%= feat.title %></h4>
            <p style="font-size:0.88rem;color:var(--text-muted);line-height:1.7;margin:0;"><%= feat.desc %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ========== HOST CALLOUT BANNER ========== -->
<% if (typeof currUser === 'undefined' || !currUser || currUser.role === 'admin') { %>
<section style="padding:5rem 0;background:var(--espresso);position:relative;overflow:hidden;">
  <!-- Background texture -->
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(221,163,92,0.07) 1px,transparent 1px);background-size:24px 24px;pointer-events:none;"></div>
  <div style="position:absolute;top:-60px;right:-60px;width:400px;height:400px;background:radial-gradient(circle,rgba(221,163,92,0.12) 0%,transparent 65%);pointer-events:none;"></div>

  <div class="container position-relative" style="z-index:2;">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <span style="display:inline-block;background:rgba(221,163,92,0.18);color:var(--amber);padding:0.35rem 1rem;border-radius:var(--radius-pill);font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;border:1px solid rgba(221,163,92,0.32);margin-bottom:1.2rem;">For Property Owners</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3.2rem);font-weight:600;color:var(--cream);line-height:1.1;margin-bottom:1rem;">
          Turn Your Home Into an<br>Extraordinary Stay
        </h2>
        <p style="color:rgba(227,222,202,0.65);font-size:1.05rem;line-height:1.7;max-width:500px;">
          Have an apartment, cabin or heritage villa? Get in touch and we'll set you up as a host.
        </p>
      </div>
      <div class="col-lg-5 text-center text-lg-end">
        <% if (typeof currUser === 'undefined' || !currUser) { %>
          <a href="/contact" style="display:inline-flex;align-items:center;gap:0.65rem;padding:1rem 2.2rem;background:var(--amber);color:var(--espresso);border-radius:var(--radius-pill);font-size:1rem;font-weight:800;text-decoration:none;box-shadow:var(--shadow-amber);margin-bottom:1rem;transition:all 0.24s;"
            onmouseover="this.style.background='var(--amber-dark)';this.style.color='white';this.style.transform='translateY(-2px)';"
            onmouseout="this.style.background='var(--amber)';this.style.color='var(--espresso)';this.style.transform='';">
            <i class="fa-solid fa-envelope"></i> Contact Us to Host
          </a>
          <br>
          <a href="/login" style="color:rgba(227,222,202,0.45);font-size:0.88rem;text-decoration:none;margin-top:0.5rem;display:inline-block;">Already a host? Log in →</a>
        <% } else { %>
          <a href="/listings/new" style="display:inline-flex;align-items:center;gap:0.65rem;padding:1rem 2.2rem;background:var(--amber);color:var(--espresso);border-radius:var(--radius-pill);font-size:1rem;font-weight:800;text-decoration:none;box-shadow:var(--shadow-amber);transition:all 0.24s;"
            onmouseover="this.style.background='var(--amber-dark)';this.style.color='white';this.style.transform='translateY(-2px)';"
            onmouseout="this.style.background='var(--amber)';this.style.color='var(--espresso)';this.style.transform='';">
            <i class="fa-solid fa-plus"></i> List Your Property
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>
<% } %>

<script>
function selectHeroCategory(val, label, el, e) {
  e.preventDefault();
  document.getElementById('hero-category-input').value = val;
  document.getElementById('hero-category-label').textContent = label;
  document.querySelectorAll('#heroCategoryDropdown + .dropdown-menu .dropdown-item').forEach(item => item.classList.remove('active'));
  el.classList.add('active');
  const dropdownBtn = document.getElementById('heroCategoryDropdown');
  if (window.bootstrap && bootstrap.Dropdown) {
    const bsDropdown = bootstrap.Dropdown.getInstance(dropdownBtn) || new bootstrap.Dropdown(dropdownBtn);
    if (bsDropdown) bsDropdown.hide();
  }
}
</script>
