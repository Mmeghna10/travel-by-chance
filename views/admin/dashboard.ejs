<% layout('/layouts/boilerplate') %>

<!-- Header -->
<div style="display:flex;align-items:center;justify-content:space-between;margin:2rem 0 2.5rem;flex-wrap:wrap;gap:1rem;">
  <div>
    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.35rem;">
      <div style="width:42px;height:42px;background:linear-gradient(135deg,var(--espresso),var(--primary));border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;color:var(--cream);font-size:1.1rem;box-shadow:var(--shadow-primary);">
        <i class="fa-solid fa-gauge-high"></i>
      </div>
      <h1 style="font-family:var(--font-display);font-size:2rem;font-weight:600;letter-spacing:-0.01em;margin:0;color:var(--dark);">Admin Control Centre</h1>
    </div>
    <p style="color:var(--text-muted);margin:0;font-size:0.93rem;">Overview of all stays, reservations, and users on TravelByChance</p>
  </div>
  <a href="/listings/new" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.5rem;background:var(--primary);color:white;border-radius:var(--radius-pill);font-weight:700;font-size:0.9rem;text-decoration:none;box-shadow:var(--shadow-primary);transition:all 0.24s;"
    onmouseover="this.style.background='var(--primary-hover)';this.style.transform='translateY(-1px)';"
    onmouseout="this.style.background='var(--primary)';this.style.transform='';">
    <i class="fa-solid fa-plus"></i> Add Listing
  </a>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
  <div class="col-12 col-sm-6 col-lg-4">
    <div class="dashboard-kpi-card" style="border-left:4px solid var(--primary);">
      <div>
        <div style="font-size:0.73rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:0.4rem;">Stays Listed</div>
        <div class="kpi-num" style="color:var(--primary);"><%= listingsCount %></div>
      </div>
      <div style="width:56px;height:56px;background:var(--primary-light);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;border:1px solid var(--primary-border);">
        <i class="fa-solid fa-hotel" style="font-size:1.4rem;color:var(--primary);"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-lg-4">
    <div class="dashboard-kpi-card" style="border-left:4px solid var(--amber);">
      <div>
        <div style="font-size:0.73rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:0.4rem;">Total Reservations</div>
        <div class="kpi-num" style="color:var(--amber-dark);"><%= bookingsCount %></div>
      </div>
      <div style="width:56px;height:56px;background:var(--amber-light);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;border:1px solid var(--amber-border);">
        <i class="fa-solid fa-calendar-check" style="font-size:1.4rem;color:var(--amber-dark);"></i>
      </div>
    </div>
  </div>

  <div class="col-12 col-sm-6 col-lg-4">
    <div class="dashboard-kpi-card" style="border-left:4px solid var(--olive);">
      <div>
        <div style="font-size:0.73rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin-bottom:0.4rem;">Registered Users</div>
        <div class="kpi-num" style="color:var(--olive);"><%= usersCount %></div>
      </div>
      <div style="width:56px;height:56px;background:var(--olive-light);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;border:1px solid var(--olive-border);">
        <i class="fa-solid fa-users" style="font-size:1.4rem;color:var(--olive);"></i>
      </div>
    </div>
  </div>
</div>

<!-- Properties Table -->
<div class="mb-4" style="background:white;border:1px solid var(--border-main);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--border-light);display:flex;align-items:center;justify-content:space-between;background:var(--cream-light);">
    <h4 style="font-weight:800;font-size:1rem;margin:0;color:var(--dark);">
      <i class="fa-solid fa-list me-2" style="color:var(--primary);"></i>Manage Properties
    </h4>
    <span style="font-size:0.8rem;color:var(--text-muted);font-weight:600;background:var(--primary-light);color:var(--primary);padding:0.2rem 0.7rem;border-radius:var(--radius-pill);border:1px solid var(--primary-border);"><%= listings.length %> total</span>
  </div>
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead style="background:var(--bg-subtle);">
        <tr>
          <% ['Stay','Host','Location','Category','Price / Night','Action'].forEach(h => { %>
            <th style="font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:var(--text-subtle);padding:0.85rem 1.25rem;border:none;"><%= h %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% for(let listing of listings) { %>
          <tr style="border-color:var(--border-light);">
            <td style="padding:1rem 1.25rem;">
              <div style="display:flex;align-items:center;gap:1rem;">
                <img src="<%= listing.image?.url || listing.image %>" style="width:54px;height:42px;object-fit:cover;border-radius:var(--radius-xs);border:1px solid var(--border-light);" alt="">
                <span style="font-weight:700;font-size:0.88rem;color:var(--text-main);"><%= listing.title %></span>
              </div>
            </td>
            <td style="padding:1rem 1.25rem;font-size:0.85rem;color:var(--text-muted);font-weight:600;">@<%= listing.owner ? listing.owner.username : 'Unknown' %></td>
            <td style="padding:1rem 1.25rem;font-size:0.85rem;color:var(--text-muted);">
              <i class="fa-solid fa-location-dot me-1" style="color:var(--primary);"></i><%= listing.location %>
            </td>
            <td style="padding:1rem 1.25rem;">
              <span style="display:inline-block;background:var(--primary-light);border:1px solid var(--primary-border);border-radius:var(--radius-pill);font-size:0.73rem;font-weight:700;padding:0.2rem 0.65rem;color:var(--primary);"><%= listing.category %></span>
            </td>
            <td style="padding:1rem 1.25rem;font-weight:800;font-size:0.9rem;color:var(--dark);">₹<%= listing.price.toLocaleString("en-IN") %></td>
            <td style="padding:1rem 1.25rem;text-align:right;">
              <a href="/listings/<%= listing._id %>" style="display:inline-flex;align-items:center;gap:0.35rem;padding:0.4rem 1rem;border:1.5px solid var(--border-dark);border-radius:var(--radius-pill);font-size:0.8rem;font-weight:700;color:var(--text-main);text-decoration:none;transition:all 0.22s;"
                onmouseover="this.style.background='var(--dark)';this.style.color='white';this.style.borderColor='var(--dark)';"
                onmouseout="this.style.background='';this.style.color='var(--text-main)';this.style.borderColor='var(--border-dark)';">
                View <i class="fa-solid fa-arrow-right" style="font-size:0.72rem;"></i>
              </a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Reservations Table -->
<div class="mb-5" style="background:white;border:1px solid var(--border-main);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);">
  <div style="padding:1.25rem 1.5rem;border-bottom:1px solid var(--border-light);display:flex;align-items:center;justify-content:space-between;background:var(--cream-light);">
    <h4 style="font-weight:800;font-size:1rem;margin:0;color:var(--dark);">
      <i class="fa-solid fa-calendar-check me-2" style="color:var(--amber-dark);"></i>System-wide Reservations
    </h4>
    <span style="font-size:0.8rem;background:var(--amber-light);color:var(--amber-dark);padding:0.2rem 0.7rem;border-radius:var(--radius-pill);border:1px solid var(--amber-border);font-weight:700;"><%= bookings.length %> total</span>
  </div>
  <div class="table-responsive">
    <table class="table mb-0 align-middle">
      <thead style="background:var(--bg-subtle);">
        <tr>
          <% ['Property','Customer','Check-in','Check-out','Total','Status'].forEach(h => { %>
            <th style="font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.07em;color:var(--text-subtle);padding:0.85rem 1.25rem;border:none;"><%= h %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% if (bookings.length === 0) { %>
          <tr><td colspan="6" style="text-align:center;padding:3rem;color:var(--text-muted);font-size:0.9rem;">No reservations found in the system.</td></tr>
        <% } else { %>
          <% for(let booking of bookings) { %>
            <tr style="border-color:var(--border-light);">
              <td style="padding:1rem 1.25rem;">
                <% if (booking.listing) { %>
                  <a href="/listings/<%= booking.listing._id %>" style="font-weight:700;font-size:0.88rem;color:var(--primary);text-decoration:none;"><%= booking.listing.title %></a>
                <% } else { %>
                  <span style="color:var(--text-muted);font-size:0.88rem;">Deleted Stay</span>
                <% } %>
              </td>
              <td style="padding:1rem 1.25rem;font-size:0.85rem;font-weight:600;color:var(--text-muted);">@<%= booking.user ? booking.user.username : 'Deleted User' %></td>
              <td style="padding:1rem 1.25rem;font-size:0.85rem;font-weight:600;color:var(--text-main);"><%= booking.checkIn.toLocaleDateString("en-IN", {day:'numeric',month:'short',year:'numeric'}) %></td>
              <td style="padding:1rem 1.25rem;font-size:0.85rem;font-weight:600;color:var(--text-main);"><%= booking.checkOut.toLocaleDateString("en-IN", {day:'numeric',month:'short',year:'numeric'}) %></td>
              <td style="padding:1rem 1.25rem;font-weight:800;color:var(--primary);font-size:0.9rem;">₹<%= booking.totalPrice.toLocaleString("en-IN") %></td>
              <td style="padding:1rem 1.25rem;">
                <span style="display:inline-block;background:var(--success-light);color:var(--success);border:1px solid rgba(74,124,89,0.3);border-radius:var(--radius-pill);font-size:0.72rem;font-weight:800;padding:0.25rem 0.75rem;text-transform:uppercase;letter-spacing:0.05em;">● Active</span>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
