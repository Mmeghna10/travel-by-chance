<% layout('/layouts/boilerplate') %>

<!-- Hero Bar -->
<div style="background:linear-gradient(160deg,var(--espresso) 0%,var(--dark) 100%);padding:3rem 0;margin:0 -12px;border-bottom:1px solid var(--border-main);">
  <div class="container-fluid px-4">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(221,163,92,0.18);color:var(--amber);border:1px solid rgba(221,163,92,0.35);padding:0.3rem 0.85rem;border-radius:var(--radius-pill);font-size:0.75rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:1rem;">
          <i class="fa-solid fa-star"></i> <%= allListings.length %> <%= allListings.length === 1 ? "stay" : "stays" %> across India
        </div>
        <h1 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3.2rem);font-weight:600;color:var(--cream);line-height:1.1;letter-spacing:-0.01em;margin-bottom:0.75rem;">
          Find Your Perfect Stay<br>
          <span style="color:var(--amber);">All across India</span>
        </h1>
        <p style="font-size:0.97rem;color:rgba(227,222,202,0.6);max-width:500px;margin-bottom:0;line-height:1.7;">
          Discover hotels, homestays, and unique experiences across India — handpicked for unforgettable journeys.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Category Filter Bar -->
<div class="categories-wrapper" style="margin:0 -12px;padding:0.85rem 1.5rem;">
  <div class="categories-flex">
    <a href="/listings" class="category-pill <%= (!category && !searchQuery) ? 'active' : '' %>" style="text-decoration:none;">
      <i class="fa-solid fa-house" style="font-size:0.85rem;"></i> All Stays
    </a>
    <% CATEGORIES.filter((c) => categoriesInUse.includes(c.name)).forEach((c) => { %>
    <a href="/listings?category=<%= encodeURIComponent(c.name) %>" class="category-pill <%= category === c.name ? 'active' : '' %>" style="text-decoration:none;">
      <i class="fa-solid <%= c.icon %>" style="font-size:0.85rem;color:<%= category === c.name ? 'rgba(255,255,255,0.75)' : c.color %>;"></i> <%= c.label %>
    </a>
    <% }); %>
  </div>
</div>

<!-- Results Bar -->
<div style="display:flex;align-items:center;justify-content:space-between;margin:0 0 1.25rem;flex-wrap:wrap;gap:0.75rem;">
  <div style="font-size:0.93rem;color:var(--text-main);font-weight:600;">
    Showing <span style="color:var(--primary);font-weight:800;"><%= allListings.length %></span> stays
    <% if(searchQuery) { %> for "<strong><%= searchQuery %></strong>"<% } %>
    <% if(category) { %> in <strong><%= category %></strong><% } %>
  </div>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
    <% if(searchQuery) { %>
      <a href="/listings<%= category ? '?category=' + encodeURIComponent(category) : '' %>"
        style="display:inline-flex;align-items:center;gap:0.4rem;background:var(--primary-light);color:var(--primary);border:1px solid var(--primary-border);padding:0.3rem 0.85rem;border-radius:var(--radius-pill);font-size:0.82rem;font-weight:700;text-decoration:none;">
        <i class="fa-solid fa-xmark"></i> Clear search
      </a>
    <% } %>
    <% if(category) { %>
      <a href="/listings<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>"
        style="display:inline-flex;align-items:center;gap:0.4rem;background:var(--primary-light);color:var(--primary);border:1px solid var(--primary-border);padding:0.3rem 0.85rem;border-radius:var(--radius-pill);font-size:0.82rem;font-weight:700;text-decoration:none;">
        <i class="fa-solid fa-xmark"></i> Clear filter
      </a>
    <% } %>
  </div>
</div>

<!-- Listings Grid or Empty State -->
<% if(allListings.length === 0) { %>
  <div style="text-align:center;padding:6rem 2rem;background:white;border-radius:var(--radius-lg);border:1px dashed var(--border-main);">
    <div style="width:72px;height:72px;background:var(--cream-light);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;border:1px solid var(--border-main);">
      <i class="fa-solid fa-magnifying-glass" style="font-size:1.8rem;color:var(--border-dark);"></i>
    </div>
    <h4 style="font-family:var(--font-display);font-weight:600;font-size:1.5rem;margin-bottom:0.5rem;color:var(--dark);">No stays found</h4>
    <p style="color:var(--text-muted);max-width:340px;margin:0 auto 1.5rem;">Try a different search term or browse all available stays.</p>
    <a href="/listings" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.75rem;background:var(--primary);color:white;border-radius:var(--radius-pill);font-weight:700;font-size:0.95rem;text-decoration:none;box-shadow:var(--shadow-primary);">
      Browse all stays
    </a>
  </div>
<% } else { %>
  <div class="listings-grid-layout">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link-wrap" style="text-decoration:none;display:block;">
        <div class="listing-card-pro">
          <div class="card-img-container">
            <img src="<%= listing.image?.url || listing.image %>" class="card-img-src" alt="<%= listing.title %>" loading="lazy">
            <button class="wishlist-heart-btn" id="wish-<%= listing._id %>" onclick="event.preventDefault();toggleWishlist(this);" aria-label="Save to wishlist">
              <i class="fa-regular fa-heart"></i>
            </button>
            <span class="card-category-badge">
              <i class="fa-solid fa-tag me-1" style="font-size:0.65rem;"></i><%= listing.category || 'Stay' %>
            </span>
          </div>
          <div class="card-body-content">
            <div class="card-location-row">
              <i class="fa-solid fa-location-dot"></i>
              <%= listing.location %>, <%= listing.country %>
            </div>
            <div class="card-title-heading"><%= listing.title %></div>
            <div class="card-rating-bar">
              <% if(listing.averageRating && listing.averageRating > 0) { %>
                <% let stars = parseFloat(listing.averageRating); %>
                <% for(let i = 1; i <= 5; i++) { %>
                  <% if(i <= stars) { %>
                    <i class="fa-solid fa-star star-icon-fill" style="font-size:0.78rem;"></i>
                  <% } else if(i - 0.5 <= stars) { %>
                    <i class="fa-solid fa-star-half-stroke star-icon-fill" style="font-size:0.78rem;"></i>
                  <% } else { %>
                    <i class="fa-regular fa-star star-icon-empty" style="font-size:0.78rem;"></i>
                  <% } %>
                <% } %>
                <span class="rating-num-text"><%= listing.averageRating %></span>
                <span class="review-count-text">(<%= listing.reviews ? listing.reviews.length : 0 %>)</span>
              <% } else { %>
                <span style="color:var(--text-subtle);font-size:0.8rem;">New — no reviews</span>
              <% } %>
            </div>
            <div class="card-footer-price">
              <div>
                <span class="price-main-amount"><span class="price-symbol">₹</span><%= listing.price.toLocaleString("en-IN") %></span>
                <span class="price-unit-label"> / night</span>
              </div>
            </div>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>

<script>
  function toggleWishlist(btn) {
    const icon = btn.querySelector('i');
    const isActive = btn.classList.toggle('active');
    icon.className = isActive ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
    if (isActive) icon.style.color = 'var(--danger)';
    else icon.style.color = '';
  }
</script>
