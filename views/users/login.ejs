<% layout("/layouts/boilerplate") %>

<div class="auth-page-container px-3">
  <div class="auth-card-pro">
    <div style="text-align:center;margin-bottom:2rem;">
      <div style="width:54px;height:54px;background:linear-gradient(135deg,var(--espresso),var(--primary));border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;color:var(--cream);font-size:1.3rem;box-shadow:var(--shadow-primary);">
        <i class="fa-solid fa-mountain-sun"></i>
      </div>
      <h1 class="auth-header-title">Welcome back</h1>
      <p class="auth-header-sub">Log in to your TravelByChance account</p>
    </div>

    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-4">
        <label for="username" class="form-label-pro">Username</label>
        <input name="username" id="username" type="text" class="form-control form-control-pro" placeholder="Enter your username" required />
        <div class="invalid-feedback">Please enter your username.</div>
      </div>
      <div class="mb-4">
        <label for="password" class="form-label-pro">Password</label>
        <input name="password" id="password" type="password" class="form-control form-control-pro" placeholder="Enter your password" required />
        <div class="invalid-feedback">Please enter your password.</div>
      </div>
      <button type="submit" class="btn-form-primary">
        <i class="fa-solid fa-arrow-right-to-bracket"></i>Log In
      </button>
    </form>

    <p style="text-align:center;margin-top:1.75rem;font-size:0.9rem;color:var(--text-muted);">
      Don't have an account?
      <a href="/signup" style="color:var(--primary);font-weight:700;text-decoration:none;">Sign up for free</a>
    </p>
  </div>
</div>
